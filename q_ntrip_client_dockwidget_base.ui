        <!-- Layer names -->
        <item>
         <layout class="QGridLayout" name="layerNameGrid">
          <item row="0" column="0">
           <widget class="QLabel" name="lblLayerPoint"><property name="text"><string>Punkte-Layer:</string></property></widget>
          </item>
          <item row="0" column="1">
           <widget class="QLineEdit" name="layerName">
            <property name="text"><string>gnss_punkte</string></property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="lblLayerTrack"><property name="text"><string>Track-Layer:</string></property></widget>
          </item>
          <item row="1" column="1">
           <widget class="QLineEdit" name="layerNameTrack">
            <property name="text"><string>gnss_track</string></property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="lblProjectedCrs"><property name="text"><string>Proj. KBS:</string></property></widget>
          </item>
          <item row="2" column="1">
           <widget class="QPushButton" name="btnSelectCrs">
            <property name="text"><string>EPSG:25832 – ETRS89 / UTM zone 32N</string></property>
            <property name="toolTip"><string>Koordinatensystem für projizierte Koordinaten (E/N) auswählen</string></property>
            <property name="styleSheet"><string>text-align:left;padding:2px 4px;</string></property>
           </widget>
          </item>
         </layout>
        </item>

        <item>
         <spacer name="measSpacer">
          <property name="orientation"><enum>Qt::Vertical</enum></property>
          <property name="sizeHint" stdset="0">
           <size><width>20</width><height>40</height></size>
          </property>
         </spacer>
        </item>
       </layout>
      </widget>

      <!-- *** Satellites Tab *** -->
      <widget class="QWidget" name="tabSatellites">
       <attribute name="title"><string>Satelliten</string></attribute>
       <layout class="QVBoxLayout" name="satLayout">
        <property name="spacing"><number>4</number></property>
        <item>
         <widget class="QTabWidget" name="satSubTabs">
          <property name="currentIndex"><number>0</number></property>
          <widget class="QWidget" name="tabSkyPlot">
           <attribute name="title"><string>Skyplot</string></attribute>
           <layout class="QVBoxLayout" name="skyPlotLayout">
            <item>
             <widget class="QWidget" name="skyPlotWidget" native="true">
              <property name="minimumSize"><size><width>200</width><height>200</height></size></property>
             </widget>
            </item>
           </layout>
          </widget>
          <widget class="QWidget" name="tabSnrChart">
           <attribute name="title"><string>SNR</string></attribute>
           <layout class="QVBoxLayout" name="snrChartLayout">
            <item>
             <widget class="QWidget" name="snrChartWidget" native="true">
              <property name="minimumSize"><size><width>200</width><height>200</height></size></property>
             </widget>
            </item>
           </layout>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- *** Recording Tab *** -->
      <widget class="QWidget" name="tabRecording">
       <attribute name="title"><string>Aufzeichnung</string></attribute>
       <layout class="QVBoxLayout" name="recLayout">
        <property name="spacing"><number>4</number></property>
        <item>
         <widget class="QGroupBox" name="grpAutoRecord">
          <property name="title"><string>Automatische Aufzeichnung</string></property>
          <property name="checkable"><bool>true</bool></property>
          <property name="checked"><bool>true</bool></property>
          <layout class="QVBoxLayout" name="autoRecLayout">
           <property name="spacing"><number>4</number></property>
           <item>
            <layout class="QHBoxLayout" name="recPathRow">
             <item>
              <widget class="QLabel" name="lblTempFolder"><property name="text"><string>Ordner:</string></property></widget>
             </item>
             <item>
              <widget class="QgsFileWidget" name="fileSelectorTempFolder">
               <property name="storageMode"><enum>QgsFileWidget::GetDirectory</enum></property>
              </widget>
             </item>
            </layout>
           </item>
           <item>
            <layout class="QHBoxLayout" name="recOptionsRow">
             <item>
              <widget class="QCheckBox" name="cbRecordReceiver">
               <property name="text"><string>Receiver (NMEA)</string></property>
               <property name="checked"><bool>true</bool></property>
              </widget>
             </item>
             <item>
              <widget class="QCheckBox" name="cbRecordRTCM">
               <property name="text"><string>RTCM</string></property>
               <property name="checked"><bool>true</bool></property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="grpProtocol">
          <property name="title"><string>Messprotokoll</string></property>
          <layout class="QVBoxLayout" name="protocolLayout">
           <item>
            <widget class="QTextEdit" name="txtProtocol">
             <property name="readOnly"><bool>true</bool></property>
             <property name="maximumHeight"><number>160</number></property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btnExportProtocol">
             <property name="text"><string>Protokoll exportieren</string></property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <spacer name="recSpacer">
          <property name="orientation"><enum>Qt::Vertical</enum></property>
          <property name="sizeHint" stdset="0">
           <size><width>20</width><height>40</height></size>
          </property>
         </spacer>
        </item>
       </layout>
      </widget>

      <!-- *** Log Tab *** -->
      <widget class="QWidget" name="tabLog">
       <attribute name="title"><string>Log</string></attribute>
       <layout class="QVBoxLayout" name="logLayout">
        <item>
         <widget class="QLabel" name="lblLogHeader">
          <property name="text"><string>Plugin-Meldungen:</string></property>
          <property name="styleSheet"><string>font-weight:bold;font-size:10px;</string></property>
         </widget>
        </item>
        <item>
         <widget class="QTextEdit" name="output">
          <property name="readOnly"><bool>true</bool></property>
          <property name="maximumHeight"><number>120</number></property>
          <property name="font">
           <font><pointsize>8</pointsize></font>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="lblNmeaLogHeader">
          <property name="text"><string>NMEA Receiver-Daten (letzte 100 Zeilen):</string></property>
          <property name="styleSheet"><string>font-weight:bold;font-size:10px;</string></property>
         </widget>
        </item>
        <item>
         <widget class="QPlainTextEdit" name="txtNmeaLog">
          <property name="readOnly"><bool>true</bool></property>
          <property name="font">
           <font><family>Consolas</family><pointsize>7</pointsize></font>
          </property>
          <property name="maximumBlockCount"><number>100</number></property>
         </widget>
        </item>
       </layout>
      </widget>

     </widget>
    </item>
   </layout>
  </widget>
 </widget>
 <customwidgets>
  <customwidget>
   <class>QgsFileWidget</class>
   <extends>QWidget</extends>
   <header>qgsfilewidget.h</header>
  </customwidget>
 </customwidgets>
